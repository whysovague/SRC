# Firebase configuration — copy this file to `.env` and fill in the values
# from Firebase Console → Project settings → Your apps → SDK setup and configuration.
# Without these, the site still runs, but registration and login are disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
