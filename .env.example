# Firebase configuration — copy this file to `.env` and fill in the values
# from Firebase Console → Project settings → Your apps → SDK setup and configuration.
# Without these, the site still runs, but registration and login are disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS — sends the registration confirmation email. See docs/EMAIL_SETUP.md.
# Firebase cannot send email from the browser and Cloud Functions need the Blaze
# plan, so this is done client-side. Without these, registration still works;
# only the confirmation email is skipped.
# Service ID and Template ID: EmailJS dashboard → Email Services / Email Templates.
# Public Key: EmailJS dashboard → Account → General. Not a secret, but restrict it
# under Account → Security → Allowed Origins.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Public origin of the deployed site, no trailing slash.
# Used to build the "Complete my profile" link in the confirmation email.
# Set this and emailed links always point at production, even when the email is
# sent from a dev server. Leave blank to use whatever origin the browser is on.
VITE_SITE_URL=https://srcsa26.com
